# MyPersonaOS Environment Variables
# Copy this file to .env.local for local development.
# Leave both variables unset to run in Local Mode.

# Supabase Credentials (Cloud Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Private-auth requirement:
# In Supabase Dashboard -> Authentication settings, disable public user sign-up
# and create only the owner account you intend to use with MyPersonaOS.
